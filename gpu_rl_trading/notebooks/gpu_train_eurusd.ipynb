<cell id="a1b2c3d4-0001-0001-0001-000000000004">from gpu_rl_trading.training.train import run_training

cfg_overrides = {
    "DATA_CSV_EURUSD":        DATA_CSV_EURUSD,
    "DATE_FROM":              "2022-01-01",
