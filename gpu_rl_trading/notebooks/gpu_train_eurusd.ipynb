    "BATCH_SIZE_ENV":         8,        # 8 parallel episodes on GPU
    "EPISODE_BARS":           21_600,   # ~15 trading days of 1m bars
    "BATCH_SIZE_RL":          256,
    "CHECKPOINT_EVERY":       10,
    "MAX_EPISODES_PER_PHASE": 500,      # hard cap before auto-advancing
    "ADVANCE_DAYS":           5,        # consecutive PASS days within one episode to advance
    # Save checkpoints + metrics to Drive so they survive session resets
    "CHECKPOINT_DIR": "/content/drive/MyDrive/gpu_rl_trading/checkpoints",
    "METRICS_DIR":    "/content/drive/MyDrive/gpu_rl_trading/metrics",
}

agent = run_training(cfg=cfg_overrides, resume=False)</cell id="a1b2c3d4-0001-0001-0001-000000000004">
<cell id="a1b2c3d4-0001-0001-0001-000000000005">import pandas as pd
from pathlib import Path

metrics_dir = Path("/content/drive/MyDrive/gpu_rl_trading/metrics")
ftmo_csv    = metrics_dir / "metrics_EURUSD_ftmo_gpu.csv"
rewards_csv = metrics_dir / "episode_rewards_EURUSD_gpu.csv"

if ftmo_csv.exists():
    df_ftmo = pd.read_csv(ftmo_csv)
    print(f"\nFTMO daily metrics ({len(df_ftmo)} days logged):")
    print(df_ftmo["ftmo_flag"].value_counts().to_string())
    print(df_ftmo.tail(10).to_string(index=False))

if rewards_csv.exists():
    df_ep = pd.read_csv(rewards_csv)
    print(f"\nEpisode rewards ({len(df_ep)} episodes):")
    print(df_ep.tail(20).to_string(index=False))</cell id="a1b2c3d4-0001-0001-0001-000000000005">
